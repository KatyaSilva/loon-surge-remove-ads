http-response-jq (?i)^https:\/\/api\.pinduoduo\.com\/api\/philo\/personal\/hub\? 'reduce (["monthly_card_entrance", "personal_center_style_v2_vo", "icon_set.icons", "icon_set.top_personal_icons", "personal_banner"] | map(split("."))[]) as $p (.; . as $d | try delpaths([$p]) catch $d)'
http-response-jq (?i)^https:\/\/api\.pinduoduo\.com\/api\/oak\/integration\/render\? 'reduce (["bottom_section_list", "ui.bottom_section", "ui.live_section.float_info"] | map(split("."))[]) as $p (.; . as $d | try delpaths([$p]) catch $d)'
http-response-jq (?i)^https:\/\/api\.pinduoduo\.com\/api\/caterham\/v3\/query\/order_detail_group\? 'reduce (["data.goods_list"] | map(split("."))[]) as $p (.; . as $d | try delpaths([$p]) catch $d)'
http-response-jq (?i)^https:\/\/api\.pinduoduo\.com\/order\/ 'reduce (["marketing_banner_vo", "shipping.banner_above_recommend"] | map(split("."))[]) as $p (.; . as $d | try delpaths([$p]) catch $d)'
http-response-jq (?i)^https:\/\/api\.pinduoduo\.com\/api\/aristotle\/order_list_v4\? '.orders |= map(.order_buttons |= map(del(.order_growth_tip)))'

