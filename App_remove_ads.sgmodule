http-response-jq (?i)^https:\/\/info\.amap\.com\/ws\/shield\/search\/poi\/detail\? 'def keep_skeleton: IN( "baseInfo", "poiDetailCommonConfig", "navbarMore", "backToTop", "poiDetailBottomBar", "poiMapModule", "anchor", "reSortContentAndSimilar", "comprehensiveEditEntrance", "functionZone", "poiTipBar", "floatTelButton", "footer_tel_button", "footer_retain_button" ); def keep_ugc: IN( "attractGalleryInfo", "combineReviews", "evaluateVO", "reviews", "inviteReview", "seriousPublicExperience", "societyPublicExperience", "poiDetailRankUpCard", "travelGuideAndQa", "poiDetailAQModule", "AIStreetTips", "expertNote", "recommend_food", "shopNews", "mallNews", "shopBaseCase" ); def keep_intro: IN( "wikiInfo", "wikiInfoBelow", "poiDetailNote", "poiDetailWikiAndLOI" ); def keep_poi_data: IN( "human_traffic", "floorGuideGbf", "houseEvaluationInfo", "residentialOwnersVO", "realtorRealStep", "houseOfficeInfo", "houseOfficeService", "houseOfficeBrandIntroduction", "houseOfficeNotice", "newHouseDetailInfo", "house_apart_info", "scenic_mustplay", "hotelGraphicDetail", "homestayGraphicDetail", "hotelFacilities", "hotelMustRead", "shoppingMallEvent" ); def keep_service: IN( "enhanceIMQuestions", "enhanceCustomerServicePoiModule", "aiAgentFooterBar", "imBottomGuide", "enhanceCustomerServiceFixedBottom", "shopBasePerson", "shopServiceBffvo", "service_process", "shopCourseList", "poiDetailJobList", "jobRec", "shop_vip_card", "shopStdActivity", "privateSphereChannel", "kaShopService", "ka_not_enter", "company1688Info", "thirdparty_info", "expressEntryCard", "poi_intercept", "aiAgentEntry", "commonAiAgent", "poiCardAiAgentEntryV2" ); def keep_guide: IN( "storeDirections", "shopFindWayGuide" ); def keep_compliance: IN( "shopQualifications", "businessQualifications", "legal_document", "home_legal_document", "rec_legal_document", "business_scope", "governmentInformation", "official_account", "merchantSettlement", "shop_settlement" ); def keep_booking: IN( "scenic_ticket", "movieBookingShelf", "hotelRooms", "ktvBookingShelf", "venueBookingShelfModule", "reserveShelf", "DinnerBottomBar", "poiDetailAppointmentRegister" ); def keep_module: keep_skeleton or keep_ugc or keep_intro or keep_poi_data or keep_service or keep_guide or keep_compliance or keep_booking; def keep_ref: (type == "string") and keep_module; def at($keys): reduce $keys[] as $k (.; if type == "object" then .[$k] else null end); def filter_refs: if type == "array" then map(select((type != "string") or keep_module)) else . end; def anchor_item_kept: (type == "object") and ((.anchor | type) == "array") and any(.anchor[]; keep_ref); def panel_item_kept: if (type == "object") and ((.modulesMap | type) == "array") then any(.modulesMap[]; keep_ref) else true end; def trim_detail: if (.data | type) == "object" then (if (.data.regions | type) == "object" then .data.regions |= with_entries(.value |= filter_refs) else . end) | (if (.data.modules | type) == "object" then .data.modules |= with_entries(select(.key | keep_module)) else . end) | (if (at(["data", "meta", "half_hidden_modules"]) | type) == "array" then .data.meta.half_hidden_modules |= filter_refs else . end) | (if (at(["data", "modules", "baseInfo", "data", "user"]) | type) == "object" then .data.modules.baseInfo.data.user |= del(.userLocRgeo, .homeInfo, .companyInfo) else . end) | (if (at(["data", "modules", "anchor", "data", "items"]) | type) == "array" then .data.modules.anchor.data.items |= map(select(anchor_item_kept)) else . end) | (if (at(["data", "modules", "poiDetailCommonConfig", "data", "swipeUpPanelConfig", "swipeUpPanelTextList"]) | type) == "array" then .data.modules.poiDetailCommonConfig.data.swipeUpPanelConfig.swipeUpPanelTextList |= map(select(panel_item_kept)) else . end) else . end; trim_detail'
